# URL pública da aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — valores públicos usados pelo cliente autenticado
NEXT_PUBLIC_SUPABASE_URL=
# Preferida em projetos novos
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidade com projetos que ainda usam a chave anon legada
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente servidor — nunca prefixar com NEXT_PUBLIC_
DATABASE_URL=
RATE_LIMIT_KEY_SECRET=
YOUTUBE_API_KEY=
YOUTUBE_PLAYLIST_IMPORT_MAX_ITEMS=1000

# Observabilidade — configuração vendor-neutral, sem endpoint ou credencial
OBSERVABILITY_ENVIRONMENT=local
OBSERVABILITY_EXPORTER=structured
OBSERVABILITY_RAW_RETENTION_DAYS=30
RELEASE_COMMIT=

# Seed local — UUID do usuário criado manualmente no Supabase Auth
SEED_ADMIN_USER_ID=
SEED_ADMIN_DISPLAY_NAME=Administrador
